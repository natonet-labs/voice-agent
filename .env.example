# --- LLM (the brain) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# --- Endpoint auth ---
# Shared secret for /v1/chat/completions; set the same value as the provider's
# API key (ElevenLabs: the OPENAI_API_KEY secret). Generate one with:
#   openssl rand -hex 32
# Requests are rejected while this is empty.
VOICE_AGENT_API_KEY=

# --- Voice provider (Option A: ElevenLabs Conversational AI) ---
# Used when the agent calls back into provider APIs; the custom-LLM
# endpoint itself needs no provider key (the provider calls us).
ELEVENLABS_API_KEY=

# --- Option B expansion (uncomment when adding an orchestrator) ---
# VAPI_API_KEY=
# RETELL_API_KEY=

# --- Server ---
LOG_LEVEL=INFO
